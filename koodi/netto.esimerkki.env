# Netto-snapshotin tunnukset. Kopio tästä tiedostosta on asetukset/netto.env;
# se ei kuulu versionhallintaan eikä pilvikansioon sen enempää kuin
# pankkihaku.env. Rivi, joka alkaa #-merkillä, on kommentti. Tyhjäksi jätetty
# arvo tarkoittaa, että lähdettä ei käytetä ja kenttä täytetään käsin.

# Kraken: luo avain osoitteessa https://pro.kraken.com/app/settings/api
# vain oikeudella "Query Funds" — ei kauppaa, ei nostoja.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# IBKR Flex Web Service (LYNX käyttää IBKR:n alustaa): Client Portal →
# Performance & Reports → Flex Queries. Tee Activity Flex Query muodossa XML,
# osioksi "Net Asset Value (NAV) in Base" tai "Equity Summary in Base", ja ota
# Flex Web Service käyttöön; token sieltä, kyselyn numero kyselyn riviltä.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
