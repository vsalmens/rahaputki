# Salaisuudet — pankkitunnukset eivät kuulu versionhallintaan
.env
*.env
*.pem

# Käyttäjän oma kansio: asetukset, kirjanpito ja aineisto.
# Nämä syntyvät myös koodin viereen, jos RAHAPUTKI_DATA ei ole asetettu.
asetukset/
data/
inbox/
raportit/
config.json
config.json.backup
saannot.csv
budjetti.csv
budjetti_ehdotus.csv

# Koneen omat asetukset. koneen-asetukset.txt on paketissa mukana oletusarvolla
# (tietokansio = .), joten se on versionhallinnassa; oma arvo pidetään poissa
# committeista komennolla  git update-index --skip-worktree koneen-asetukset.txt
# Aiemmat nimet eivät kuulu repoon lainkaan.
paikalliset.txt
datakansio.txt

# Kahden koneen lukot — ajonaikaisia, katoavat itsestään
.lukko.*.json

# Kaikki data — ei koskaan repoon. Mallipohja on ainoa poikkeus.
*.csv
!koodi/saannot.esimerkki.csv

# Claude Coden omat asetukset — kehittäjän työkalu, ei osa ohjelmaa
.claude/

# Pythonin välimuisti ja käyttöjärjestelmän roskat
__pycache__/
*.pyc
.DS_Store
