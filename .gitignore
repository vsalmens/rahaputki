# Salaisuudet — pankkitunnukset eivät kuulu versionhallintaan
.env
*.env
*.pem

# Käyttäjän oma kansio: asetukset, kirjanpito ja aineisto.
# Nämä syntyvät myös koodin viereen, jos RAHAPUTKI_DATA ei ole asetettu.
asetukset/
data/
inbox/
raportit/
config.json
config.json.backup
saannot.csv
budjetti.csv
budjetti_ehdotus.csv

# Konekohtainen osoitin datakansioon — eri jokaisella koneella
datakansio.txt

# Kahden koneen lukot — ajonaikaisia, katoavat itsestään
.lukko.*.json

# Kaikki data — ei koskaan repoon. Mallipohja on ainoa poikkeus.
*.csv
!koodi/saannot.esimerkki.csv

# Pythonin välimuisti ja käyttöjärjestelmän roskat
__pycache__/
*.pyc
.DS_Store
